#!/bin/sh
# Entry point of the AppImage.
#
# libmpv links against libpipewire and libjack. Neither may be bundled
# outright: each has to match the sound server on the host, which is why
# linuxdeploy leaves them out. But a host without them cannot start leolink at
# all, since the loader refuses the whole program over one missing library.
# So a copy of each travels in usr/lib/fallback/, and is put on the library
# path only when the host has none of its own.

here=$(dirname "$(readlink -f "$0")")

for lib in pipewire:libpipewire-0.3.so.0 jack:libjack.so.0; do
    dir=${lib%%:*}
    soname=${lib#*:}
    if ! /sbin/ldconfig -p 2>/dev/null | grep -q "[[:space:]]$soname "; then
        LD_LIBRARY_PATH="$here/usr/lib/fallback/$dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    fi
done
export LD_LIBRARY_PATH

exec "$here/usr/bin/leolink" "$@"
